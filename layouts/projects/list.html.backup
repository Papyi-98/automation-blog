{{ define "main" }}
<div class="container mx-auto px-4 py-16">
    <!-- Minimal Header -->
    <div class="text-center mb-16 max-w-3xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold mb-6 text-gray-900 dark:text-white">
            {{ .Title }}
        </h1>
        
        <p class="text-xl text-gray-600 dark:text-gray-300">
            {{ .Description }}
        </p>
    </div>
    
    <!-- Main Content - Minimal -->
    <div class="max-w-4xl mx-auto">
        <div class="prose dark:prose-invert prose-lg max-w-none mb-16">
            {{ .Content }}
        </div>
        
        <!-- Category Cards - Minimal -->
        <div class="grid md:grid-cols-2 gap-8">
            <!-- Web Development Card -->
            <div class="group relative bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-8 border border-gray-200 dark:border-gray-700 hover:shadow-2xl transition-all duration-300 hover:border-primary/30">
                <div class="absolute top-6 right-6 text-3xl text-gray-300 dark:text-gray-700 group-hover:text-primary/20 transition-colors">
                    <i class="fas fa-code"></i>
                </div>
                <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">Web Development</h3>
                <p class="text-gray-600 dark:text-gray-300 mb-8">
                    Build automation, deployment pipelines, and web applications.
                </p>
                <a href="/projects/categories/web-development/" class="inline-flex items-center text-primary hover:text-primary-dark font-medium text-lg">
                    View Projects <i class="fas fa-arrow-right ml-3 group-hover:ml-4 transition-all"></i>
                </a>
            </div>
            
            <!-- DevOps Card -->
            <div class="group relative bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-8 border border-gray-200 dark:border-gray-700 hover:shadow-2xl transition-all duration-300 hover:border-primary/30">
                <div class="absolute top-6 right-6 text-3xl text-gray-300 dark:text-gray-700 group-hover:text-primary/20 transition-colors">
                    <i class="fas fa-server"></i>
                </div>
                <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">CI/CD & DevOps</h3>
                <p class="text-gray-600 dark:text-gray-300 mb-8">
                    Automated testing, deployment, and infrastructure management.
                </p>
                <a href="/projects/categories/devops/" class="inline-flex items-center text-primary hover:text-primary-dark font-medium text-lg">
                    View Projects <i class="fas fa-arrow-right ml-3 group-hover:ml-4 transition-all"></i>
                </a>
            </div>
            
            <!-- Workflow Automation Card -->
            <div class="group relative bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-8 border border-gray-200 dark:border-gray-700 hover:shadow-2xl transition-all duration-300 hover:border-primary/30">
                <div class="absolute top-6 right-6 text-3xl text-gray-300 dark:text-gray-700 group-hover:text-primary/20 transition-colors">
                    <i class="fas fa-cogs"></i>
                </div>
                <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">Workflow Automation</h3>
                <p class="text-gray-600 dark:text-gray-300 mb-8">
                    Business process automation and task optimization.
                </p>
                <a href="/projects/categories/workflow-automation/" class="inline-flex items-center text-primary hover:text-primary-dark font-medium text-lg">
                    View Projects <i class="fas fa-arrow-right ml-3 group-hover:ml-4 transition-all"></i>
                </a>
            </div>
            
            <!-- Data Processing Card -->
            <div class="group relative bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-8 border border-gray-200 dark:border-gray-700 hover:shadow-2xl transition-all duration-300 hover:border-primary/30">
                <div class="absolute top-6 right-6 text-3xl text-gray-300 dark:text-gray-700 group-hover:text-primary/20 transition-colors">
                    <i class="fas fa-database"></i>
                </div>
                <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">Data Processing</h3>
                <p class="text-gray-600 dark:text-gray-300 mb-8">
                    Web scraping, data collection, and analysis pipelines.
                </p>
                <a href="/projects/categories/data-processing/" class="inline-flex items-center text-primary hover:text-primary-dark font-medium text-lg">
                    View Projects <i class="fas fa-arrow-right ml-3 group-hover:ml-4 transition-all"></i>
                </a>
            </div>
        </div>
        
        <!-- Minimal Footer Note -->
        <div class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-800 text-center">
            <p class="text-gray-500 dark:text-gray-400">
                Detailed project documentation and case studies available in each category.
            </p>
        </div>
    </div>
</div>
{{ end }}
