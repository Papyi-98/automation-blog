{{ define "main" }}
{{/* Get all projects data */}}
{{ $allProjects := $.Site.Data.projects }}
{{/* Get current category from URL slug */}}
{{ $currentCategory := .File.ContentBaseName }}

<div class="container mx-auto px-4 py-16">
    <!-- Category Header -->
    <div class="text-center mb-12 max-w-3xl mx-auto">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary/10 text-primary text-2xl mb-6">
            <i class="fas fa-folder"></i>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold mb-4 text-gray-900 dark:text-white">
            {{ .Title }}
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 mb-6">
            {{ .Description }}
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <div class="inline-flex items-center gap-2 text-gray-500 dark:text-gray-400">
                <i class="fas fa-project-diagram"></i>
                <span>{{ len (where $allProjects "category" $currentCategory) }} projects</span>
            </div>
            
            <!-- Update Projects Button -->
            <button id="updateProjectsBtn" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-dark text-white px-5 py-2.5 rounded-lg font-medium transition-colors">
                <i class="fas fa-plus"></i>
                <span>Add New Project</span>
            </button>
        </div>
    </div>

    <!-- Update Projects Modal (Hidden by default) -->
    <div id="updateProjectsModal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto">
            <!-- Modal Header -->
            <div class="sticky top-0 bg-white dark:bg-gray-800 p-6 border-b border-gray-200 dark:border-gray-700 rounded-t-2xl">
                <div class="flex items-center justify-between">
                    <h3 class="text-2xl font-bold text-gray-900 dark:text-white">
                        <i class="fas fa-plus-circle mr-2"></i>Add New Project
                    </h3>
                    <button id="closeModalBtn" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300 text-2xl">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <p class="text-gray-600 dark:text-gray-300 mt-2">
                    Add a new project to the <span class="font-semibold">{{ .Title }}</span> category
                </p>
            </div>

            <!-- Modal Form -->
            <div class="p-6">
                <form id="projectForm" class="space-y-6">
                    <!-- Hidden category field -->
                    <input type="hidden" id="projectCategory" name="category" value="{{ $currentCategory }}">

                    <!-- Project Title -->
                    <div>
                        <label for="projectTitle" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Project Title *
                        </label>
                        <input type="text" id="projectTitle" name="title" required
                            class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent"
                            placeholder="e.g., Email Automation System">
                    </div>

                    <!-- Project Description -->
                    <div>
                        <label for="projectDescription" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Description *
                        </label>
                        <textarea id="projectDescription" name="description" rows="3" required
                            class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white resize-none focus:ring-2 focus:ring-primary focus:border-transparent"
                            placeholder="Brief description of what the project does..."></textarea>
                    </div>

                    <!-- Status -->
                    <div>
                        <label for="projectStatus" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Status *
                        </label>
                        <select id="projectStatus" name="status" required
                            class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent">
                            <option value="planned">Planned</option>
                            <option value="in-progress">In Progress</option>
                            <option value="completed" selected>Completed</option>
                        </select>
                    </div>

                    <!-- Technologies -->
                    <div>
                        <label for="projectTechnologies" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Technologies (comma-separated) *
                        </label>
                        <input type="text" id="projectTechnologies" name="tech" required
                            class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent"
                            placeholder="e.g., Python, FastAPI, MongoDB, Docker">
                        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Separate technologies with commas</p>
                    </div>

                    <!-- GitHub URL -->
                    <div>
                        <label for="projectGitHub" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            GitHub Repository URL
                        </label>
                        <input type="url" id="projectGitHub" name="github"
                            class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent"
                            placeholder="https://github.com/username/project-name">
                    </div>

                    <!-- Live Demo URL -->
                    <div>
                        <label for="projectLive" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            Live Demo URL (optional)
                        </label>
                        <input type="url" id="projectLive" name="live"
                            class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent"
                            placeholder="https://demo.example.com">
                    </div>

                    <!-- Featured Project -->
                    <div class="flex items-center">
                        <input type="checkbox" id="projectFeatured" name="featured"
                            class="h-5 w-5 text-primary rounded border-gray-300 dark:border-gray-600 focus:ring-primary">
                        <label for="projectFeatured" class="ml-3 text-sm font-medium text-gray-700 dark:text-gray-300">
                            Mark as Featured Project
                        </label>
                    </div>

                    <!-- Form Actions -->
                    <div class="flex flex-wrap gap-4 pt-4 border-t border-gray-200 dark:border-gray-700">
                        <button type="button" id="cancelBtn" class="px-6 py-3 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                            Cancel
                        </button>
                        <button type="submit" id="submitBtn" class="flex-1 px-6 py-3 bg-primary hover:bg-primary-dark text-white rounded-lg font-medium transition-colors">
                            <span id="submitText">Add Project</span>
                            <span id="submitSpinner" class="hidden ml-2">
                                <i class="fas fa-spinner fa-spin"></i>
                            </span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Projects List -->
    <div class="max-w-6xl mx-auto">
        {{ $categoryProjects := where $allProjects "category" $currentCategory }}
        {{ if $categoryProjects }}
            <div class="space-y-8">
                {{ range $index, $project := $categoryProjects }}
                <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg overflow-hidden border border-gray-200 dark:border-gray-700">
                    <!-- Project Header -->
                    <div class="p-6 border-b border-gray-200 dark:border-gray-700">
                        <div class="flex items-start justify-between">
                            <div class="flex-1">
                                <div class="flex items-center gap-3 mb-2">
                                    <span class="text-2xl">{{ .icon }}</span>
                                    <h3 class="text-2xl font-bold text-gray-900 dark:text-white">
                                        {{ .title }}
                                    </h3>
                                </div>
                                
                                <div class="flex items-center gap-3 flex-wrap">
                                    <span class="px-3 py-1 rounded-full text-sm font-medium
                                        {{ if eq .status "completed" }}bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200
                                        {{ else if eq .status "in-progress" }}bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200
                                        {{ else }}bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200{{ end }}">
                                        {{ .status | title }}
                                    </span>
                                    <span class="text-gray-500 dark:text-gray-400 text-sm">
                                        <i class="fas fa-calendar mr-1"></i>{{ .date | time.Format "Jan 2, 2006" }}
                                    </span>
                                    <span class="text-gray-500 dark:text-gray-400 text-sm">
                                        <i class="fas fa-clock mr-1"></i>{{ .readTime }}
                                    </span>
                                </div>
                            </div>
                            
                            {{ if .featured }}
                            <span class="ml-4 px-3 py-1 bg-primary/10 text-primary rounded-full text-sm font-medium">
                                <i class="fas fa-star mr-1"></i> Featured
                            </span>
                            {{ end }}
                        </div>
                    </div>

                    <!-- Project Description -->
                    <div class="p-6">
                        <p class="text-gray-700 dark:text-gray-300 text-lg mb-6">
                            {{ .description }}
                        </p>

                        <!-- Technologies -->
                        <div class="mb-6">
                            <h4 class="text-sm font-semibold text-gray-500 dark:text-gray-400 mb-3">Technologies Used</h4>
                            <div class="flex flex-wrap gap-2">
                                {{ range .tech }}
                                <span class="bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 px-3 py-1.5 rounded-lg text-sm font-medium">
                                    {{ . }}
                                </span>
                                {{ end }}
                            </div>
                        </div>

                        <!-- Links -->
                        <div class="flex flex-wrap gap-4">
                            {{ if .github }}
                            <a href="{{ .github }}" target="_blank" class="inline-flex items-center gap-2 bg-gray-900 dark:bg-gray-700 hover:bg-gray-800 dark:hover:bg-gray-600 text-white px-5 py-2.5 rounded-lg font-medium transition-colors">
                                <i class="fab fa-github"></i>
                                <span>View Code</span>
                            </a>
                            {{ end }}
                            {{ if .live }}
                            <a href="{{ .live }}" target="_blank" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-dark text-white px-5 py-2.5 rounded-lg font-medium transition-colors">
                                <i class="fas fa-external-link-alt"></i>
                                <span>Live Demo</span>
                            </a>
                            {{ end }}
                            <button class="show-comments-btn inline-flex items-center gap-2 text-primary hover:text-primary-dark font-medium px-4 py-2.5" data-project-id="{{ .id }}">
                                <i class="fas fa-comment"></i>
                                <span>Comments (0)</span>
                            </button>
                        </div>
                    </div>

                    <!-- Comment Section (Hidden by default) -->
                    <div id="comments-{{ .id }}" class="comments-section hidden p-6 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
                        <div class="flex items-center justify-between mb-4">
                            <h4 class="text-lg font-semibold text-gray-900 dark:text-white">
                                <i class="fas fa-comments mr-2"></i>Discussion
                            </h4>
                            <button class="close-comments-btn text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300" data-project-id="{{ .id }}">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        
                        <!-- Comment Form -->
                        <div class="mb-6">
                            <textarea class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white resize-none focus:ring-2 focus:ring-primary focus:border-transparent" rows="3" placeholder="Add your comment or question about this project..."></textarea>
                            <div class="flex justify-end mt-3">
                                <button class="px-5 py-2 bg-primary hover:bg-primary-dark text-white rounded-lg font-medium transition-colors">
                                    Post Comment
                                </button>
                            </div>
                        </div>

                        <!-- Comments List -->
                        <div class="space-y-4">
                            <div class="text-center py-8 text-gray-500 dark:text-gray-400">
                                <i class="fas fa-comment-slash text-3xl mb-3"></i>
                                <p>No comments yet. Be the first to share your thoughts!</p>
                            </div>
                        </div>
                    </div>
                </div>
                {{ end }}
            </div>
        {{ else }}
            <div class="text-center py-16">
                <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-400 dark:text-gray-600 text-3xl mb-6">
                    <i class="fas fa-folder-open"></i>
                </div>
                <h3 class="text-2xl font-semibold text-gray-700 dark:text-gray-300 mb-3">No projects yet</h3>
                <p class="text-gray-500 dark:text-gray-400 mb-6">Be the first to add a project to this category!</p>
                <button id="addFirstProjectBtn" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-dark text-white px-5 py-2.5 rounded-lg font-medium transition-colors">
                    <i class="fas fa-plus"></i>
                    <span>Add First Project</span>
                </button>
            </div>
        {{ end }}

        <!-- Back to Projects -->
        <div class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700 text-center">
            <a href="/projects/" class="inline-flex items-center gap-2 text-primary hover:text-primary-dark font-medium text-lg">
                <i class="fas fa-arrow-left"></i>
                <span>Back to All Categories</span>
            </a>
        </div>
    </div>
</div>

<!-- Project Management JavaScript -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('updateProjectsModal');
    const openBtn = document.getElementById('updateProjectsBtn');
    const closeBtn = document.getElementById('closeModalBtn');
    const cancelBtn = document.getElementById('cancelBtn');
    const addFirstBtn = document.getElementById('addFirstProjectBtn');
    const form = document.getElementById('projectForm');
    const submitBtn = document.getElementById('submitBtn');
    const submitText = document.getElementById('submitText');
    const submitSpinner = document.getElementById('submitSpinner');

    // Open modal
    function openModal() {
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    // Close modal
    function closeModal() {
        modal.classList.add('hidden');
        document.body.style.overflow = 'auto';
        form.reset();
    }

    // Open modal handlers
    if (openBtn) openBtn.addEventListener('click', openModal);
    if (addFirstBtn) addFirstBtn.addEventListener('click', openModal);

    // Close modal handlers
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

    // Close modal when clicking outside
    modal.addEventListener('click', function(e) {
        if (e.target === modal) {
            closeModal();
        }
    });

    // Close modal with Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
            closeModal();
        }
    });

    // Form submission
    form.addEventListener('submit', function(e) {
    e.preventDefault();
    
    // Show loading state
    submitBtn.disabled = true;
    submitText.textContent = 'Generating...';
    submitSpinner.classList.remove('hidden');

    // Get form data
    const formData = {
        title: document.getElementById('projectTitle').value,
        description: document.getElementById('projectDescription').value,
        category: document.getElementById('projectCategory').value,
        status: document.getElementById('projectStatus').value,
        tech: document.getElementById('projectTechnologies').value,
        github: document.getElementById('projectGitHub').value || '',
        live: document.getElementById('projectLive').value || '',
        featured: document.getElementById('projectFeatured').checked,
        icon: '??',
        readTime: '5 min'
    };

    // Create PowerShell command
    let psCommand = ".\\Add-Project.ps1 ";
    psCommand += `-Category "${formData.category}" `;
    psCommand += `-Title "${formData.title.replace(/"/g, '`"')}" `;
    psCommand += `-Description "${formData.description.replace(/"/g, '`"')}" `;
    psCommand += `-Status "${formData.status}" `;
    psCommand += `-Tech "${formData.tech}" `;
    
    if (formData.github) {
        psCommand += `-GitHub "${formData.github}" `;
    }
    
    if (formData.live) {
        psCommand += `-Live "${formData.live}" `;
    }
    
    if (formData.featured) {
        psCommand += "-Featured ";
    }
    
    psCommand += `-Icon "${formData.icon}" `;
    psCommand += `-ReadTime "${formData.readTime}"`;

    // Reset button state
    submitBtn.disabled = false;
    submitText.textContent = 'Add Project';
    submitSpinner.classList.add('hidden');

    // Show command in modal
    const commandDisplay = `
<div class="mt-4 p-4 bg-gray-900 dark:bg-gray-800 rounded-lg">
    <div class="flex items-center justify-between mb-2">
        <h4 class="text-sm font-semibold text-gray-300">PowerShell Command</h4>
        <button onclick="copyPsCommand(this)" class="text-xs text-primary hover:text-primary-dark">
            <i class="fas fa-copy mr-1"></i>Copy
        </button>
    </div>
    <pre class="text-sm text-gray-200 overflow-x-auto p-3 bg-black/50 rounded"><code id="psCommandCode">${psCommand}</code></pre>
    <p class="text-xs text-gray-400 mt-2">
        Run this command in PowerShell from your project directory to add the project.
    </p>
</div>

<div class="mt-4 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
    <h4 class="text-sm font-semibold text-blue-800 dark:text-blue-300 mb-2">
        <i class="fas fa-terminal mr-1"></i>Or use interactive mode:
    </h4>
    <pre class="text-sm text-blue-800 dark:text-blue-300 overflow-x-auto p-2 bg-white/50 dark:bg-black/50 rounded"><code>.\\Add-Project-Interactive.ps1</code></pre>
</div>`;

    // Replace form with command display
    const formContainer = document.querySelector('.p-6');
    const originalForm = formContainer.innerHTML;
    
    formContainer.innerHTML = `
        <div>
            <div class="text-center mb-6">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-100 dark:bg-green-900 text-green-600 dark:text-green-300 text-2xl mb-4">
                    <i class="fas fa-code"></i>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">PowerShell Command Ready</h3>
                <p class="text-gray-600 dark:text-gray-300">
                    Copy and run this command to add "<strong>${formData.title}</strong>"
                </p>
            </div>
            
            ${commandDisplay}
            
            <div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700 flex gap-4">
                <button onclick="location.reload()" class="flex-1 px-6 py-3 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                    Add Another
                </button>
                <button onclick="closeModal()" class="flex-1 px-6 py-3 bg-primary hover:bg-primary-dark text-white rounded-lg font-medium transition-colors">
                    Done
                </button>
            </div>
        </div>`;
});

// Copy command function
window.copyPsCommand = function(button) {
    const code = document.getElementById('psCommandCode');
    const text = code.textContent;
    
    navigator.clipboard.writeText(text).then(() => {
        const originalHtml = button.innerHTML;
        button.innerHTML = '<i class="fas fa-check mr-1"></i>Copied!';
        button.classList.add('text-green-500');
        
        setTimeout(() => {
            button.innerHTML = originalHtml;
            button.classList.remove('text-green-500');
        }, 2000);
    });
};;

        try {
            // Simulate API call (for now - we'll implement actual saving later)
            await new Promise(resolve => setTimeout(resolve, 1000));
            
            // For now, show success message
            alert(`Project "${formData.title}" added successfully!\n\nNote: This is a front-end demonstration. In a real implementation, this would save to your projects.json file.\n\nTo actually add this project, you would need to:\n1. Edit the projects.json file manually\n2. Or implement a backend API`);
            
            closeModal();
            
        } catch (error) {
            alert('Error adding project: ' + error.message);
        } finally {
            // Reset button state
            submitBtn.disabled = false;
            submitText.textContent = 'Add Project';
            submitSpinner.classList.add('hidden');
        }
    });

    // Comment System JavaScript (from previous implementation)
    document.querySelectorAll('.show-comments-btn').forEach(button => {
        button.addEventListener('click', function() {
            const projectId = this.getAttribute('data-project-id');
            const commentsSection = document.getElementById(`comments-${projectId}`);
            commentsSection.classList.remove('hidden');
            this.classList.add('hidden');
        });
    });

    document.querySelectorAll('.close-comments-btn').forEach(button => {
        button.addEventListener('click', function() {
            const projectId = this.getAttribute('data-project-id');
            const commentsSection = document.getElementById(`comments-${projectId}`);
            const showButton = document.querySelector(`.show-comments-btn[data-project-id="${projectId}"]`);
            
            commentsSection.classList.add('hidden');
            if (showButton) {
                showButton.classList.remove('hidden');
            }
        });
    });
});
</script>

<!-- Modal and Comment Styles -->
<style>
#updateProjectsModal {
    backdrop-filter: blur(4px);
}
.modal-content {
    animation: modalSlideIn 0.3s ease-out;
}
@keyframes modalSlideIn {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
.comments-section {
    transition: all 0.3s ease;
}
.hidden {
    display: none !important;
}
</style>
{{ end }}

